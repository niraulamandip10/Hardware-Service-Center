@model LedgerModel

@{
    ViewData["Title"] = "Create Ledger";
}

<div class="page-content">

    @if (TempData["Error"] != null)
    {
        <div id="toaster-data"
             data-toaster-message="@TempData["Error"]"
             data-toaster-type="error"
             style="display:none;">
        </div>
    }

    <div class="theme-header d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-custom mb-1">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-fill me-1"></i>Home
                        </a>
                    </li>

                    <li class="breadcrumb-item">
                        <a asp-action="Report">
                            <i class="bi bi-journal-text me-1"></i>Ledgers
                        </a>
                    </li>

                    <li class="breadcrumb-item active fw-semibold">
                        Create
                    </li>
                </ol>
            </nav>

            <h3 class="fw-bold mb-0">
                <i class="bi bi-journal-plus me-2 text-primary"></i>
                Create Ledger
            </h3>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">

            <div class="theme-card">

                <div class="theme-card-header">
                    <div class="header-icon">
                        <i class="bi bi-journal-text"></i>
                    </div>

                    <div>
                        <h5 class="mb-0">Ledger Information</h5>
                        <small>
                            Enter the details below to create a new ledger
                        </small>
                    </div>
                </div>

                <div class="theme-card-body">

                    <form asp-action="CreateLedger"
                          method="post"
                          novalidate>

                        <div class="row g-4">

                            <!-- COA Ledger -->
                            
                            <div class="col-md-6">
                                <div class="form-floating">

                                    <select asp-for="CoaLedgerId"
                                            class="form-select form-control-custom">

                                        <option value="">
                                            -- Select COA Ledger --
                                        </option>
                                        <option value="1">Assets</option>
                                        <option value="2">Liabilities</option>
                                        <option value="3">Income</option>
                                        <option value="4">Expenses</option>
                                    </select>

                                    <label asp-for="CoaLedgerId">
                                        <i class="bi bi-fill me-2 text-primary"></i>
                                        COA Ledger
                                    </label>

                                    <span asp-validation-for="CoaLedgerId"
                                          class="text-danger small">
                                    </span>

                                </div>
                            </div>
                            
                            
                            <!-- Ledger Name -->
                            <div class="col-md-6">
                                <div class="form-floating">

                                    <input asp-for="LedgerName"
                                           class="form-control form-control-custom"
                                           placeholder="Ledger Name" />

                                    <label asp-for="LedgerName">
                                        <i class="bi bi-text me-2 text-primary"></i>
                                        Ledger Name
                                    </label>

                                    <span asp-validation-for="LedgerName"
                                          class="text-danger small">
                                    </span>

                                </div>
                            </div>

                            <!-- Ledger Code -->
                            <div class="col-md-6">
                                <div class="form-floating">

                                    <input asp-for="LedgerCode"
                                           class="form-control form-control-custom"
                                           placeholder="Ledger Code" />

                                    <label asp-for="LedgerCode">
                                        <i class="bi bi- me-2 text-primary"></i>
                                        Ledger Code
                                    </label>

                                    <span asp-validation-for="LedgerCode"
                                          class="text-danger small">
                                    </span>

                                </div>
                            </div>
                            

                            <!-- Rec Date -->
                            <div class="col-md-6">
                                <div class="form-floating">

                                    <input asp-for="RecDate"
                                           type="date"
                                           class="form-control form-control-custom"
                                           value="@DateTime.Now.ToString("yyyy-MM-dd")" disabled="disabled" />

                                    <label asp-for="RecDate">
                                        <i class="bi bi-calendar-date me-2 text-primary"></i>
                                        Rec Date
                                    </label>

                                    <span asp-validation-for="RecDate"
                                          class="text-danger small">
                                    </span>

                                </div>
                            </div>
                            
                            

                            <!-- Description -->
                            <div class="col-12">
                                <div class="form-floating">

                                    <textarea asp-for="Description"
                                              class="form-control form-control-custom"
                                              placeholder="Description"
                                              style="height:120px"></textarea>

                                    <label asp-for="Description">
                                        <i class="bi bi-card-text me-2 text-primary"></i>
                                        Description
                                    </label>

                                    <span asp-validation-for="Description"
                                          class="text-danger small">
                                    </span>

                                </div>
                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex gap-2 justify-content-end">

                            <a asp-action="Report"
                               class="btn-secondary-outline px-4">
                                <i class="bi bi-arrow-left"></i>
                                Back to List
                            </a>

                            <button type="submit"
                                    class="btn-primary-blue px-5">
                                <i class="bi bi-check-lg"></i>
                                Save Ledger
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}